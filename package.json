{
  "homepage": "https://antuhere.github.io/",
  "name": "protfolio",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@apollo/react-hooks": "^4.0.0",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^11.2.7",
    "@testing-library/user-event": "^12.8.3",
    "apollo-boost": "^0.4.9",
    "colorthief": "^2.3.2",
    "font-awesome": "^4.7.0",
    "graphql": "^15.6.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-easy-emoji": "^1.6.1",
    "react-headroom": "^3.1.1",
    "react-lottie": "^1.2.3",
    "react-reveal": "^1.2.2",
    "react-router-dom": "^5.3.0",
    "react-scripts": "^1.1.5",
    "react-twitter-embed": "^4.0.4",
    "sass": "^1.49.9",
    "web-vitals": "^1.1.2"
  },
  "scripts": {
    "predeploy": "node scripts/prepare-pages.cjs && npm run build",
    "deploy": "gh-pages -d build",
    "start": "react-scripts start",
    "build": "npm run build:portfolio && npm run build:researchos",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "build:portfolio": "react-scripts build",
    "build:researchos": "npm --prefix researchos run build",
    "prestart": "npm --prefix researchos run build -- --outDir ../public/researchos --emptyOutDir",
    "start:researchos": "npm --prefix researchos run dev",
    "test:researchos": "npm --prefix researchos run test:e2e --"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "gh-pages": "^3.2.3"
  }
}
